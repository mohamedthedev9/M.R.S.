{
  "name": "mrs-website",
  "version": "0.1.0",
  "private": true,
  "description": "Official website for M.R.S. (Mohamed Reda Services)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:launch": "node tools/check-placeholders.js",
    "prebuild": "node tools/check-placeholders.js --warn",
    "copy:review": "node tools/gen-copy.js",
    "security:scan": "node tools/security-scan.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run security:scan && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "next": "^16.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0"
  }
}
